{
    "Version": "2012-10-17",
    "Statement": [
      { "Effect": "Allow",
        "Action": ["s3:ListBucket"],
        "Resource": "arn:aws:s3:::kh-experiment-test"
      },
      { "Effect": "Allow",
        "Action": [
          "s3:GetObject","s3:PutObject","s3:DeleteObject",
          "s3:AbortMultipartUpload","s3:ListBucketMultipartUploads","s3:ListMultipartUploadParts"
        ],
        "Resource": "arn:aws:s3:::kh-experiment-test/*"
      },
      { "Effect": "Allow",
        "Action": [
          "s3:GetBucketLocation","s3:PutBucketWebsite","s3:PutBucketPolicy",
          "s3:PutBucketCors","s3:PutPublicAccessBlock","s3:PutBucketAccelerateConfiguration"
        ],
        "Resource": "arn:aws:s3:::kh-experiment-test"
      }
    ]
  }
  